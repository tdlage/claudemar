TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# ── Gateway de LLM (Bifrost) ──
# O Agent SDK aponta para o gateway (GATEWAY_URL), que roteia para o provedor do perfil
# ativo (Settings → Provedores de LLM) pelo nome do modelo (provider/modelo). As chaves
# abaixo são consumidas pelo gateway Bifrost.
GATEWAY_URL=http://localhost:8080/anthropic
# OpenAI: usada pelo gateway (modelos GPT) e pela transcrição de voz (Whisper).
OPENAI_API_KEY=
# z.ai (GLM):
ZAI_API_KEY=
# Sakana AI (Fugu):
SAKANA_API_KEY=
# Anthropic via gateway — separada de ANTHROPIC_API_KEY p/ não substituir a subscription do Claude:
BIFROST_ANTHROPIC_API_KEY=
# Opcional: virtual key do Bifrost (quando a governança está habilitada):
BIFROST_VIRTUAL_KEY=

AGENT_TIMEOUT_MS=0
# Timeout de inatividade do runner do Agent SDK (ms). Se o SDK ficar travado
# silenciosamente (ex: session limit da conta), encerra a execução como erro.
# 0 = desligado. Padrão: 10 minutos.
SESSION_INACTIVITY_TIMEOUT_MS=600000
MAX_OUTPUT_LENGTH=4096
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000
# URL pública do dashboard. Exemplo de produção: https://claudemar.com.br
# Usada para embutir screenshots do E2E nos Pull Requests e para derivar o RP ID do WebAuthn.
# Vazio = recursos que dependem de URL pública ficam desativados.
PUBLIC_BASE_URL=

# MySQL (required for Tracker feature)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=claudemar
MYSQL_PASSWORD=
MYSQL_DATABASE=claudemar

# Long-term memory (Qdrant + Voyage). Leave QDRANT_URL/VOYAGE_API_KEY empty to disable memory.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claudemar_sessions
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIM=1024
RERANK_MODEL=rerank-2.5
MEMORY_DOMAIN_INSTRUCTION=
RETRIEVE_CANDIDATES=40
RERANK_TOP_K=8
HYBRID_BM25=true
MEMORY_RECONCILE=false

# Pipeline (esteira de desenvolvimento por agente)
MAX_PARALLEL_PIPELINE_RUNS=3
# Timeout padrão de cada etapa (ms). Override por etapa na UI: vazio = usa este padrão,
# 0 = sem limite (para tasks longas), N = N minutos. Padrão: 2h.
PIPELINE_STAGE_TIMEOUT_MS=7200000
# WebAuthn / Passkeys (login biométrico para admin).
# RP ID = domínio exato onde o dashboard roda, sem protocolo/porta. Exemplo: claudemar.com.br
# Em dev pode ficar como localhost. Deixe vazio para derivar de PUBLIC_BASE_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Claudemar

# ── Second Brain ──
# Redis (Streams/cursores/filas do brain). Serviço `redis` do docker-compose.
REDIS_URL=redis://127.0.0.1:6379
# Raiz do repositório do brain (raw/, wiki/, state/). Vazio = <basePath>/brain.
BRAIN_ROOT=
BRAIN_TZ=Europe/Madrid
# Chave da Anthropic dedicada ao pipeline do brain (triagem/compilação).
# NÃO usar ANTHROPIC_API_KEY: substituiria a auth por subscription do Agent SDK.
BRAIN_ANTHROPIC_API_KEY=
# OAuth client do Google Cloud (Gmail + Calendar, escopo readonly).
# Redirect URI: <PUBLIC_BASE_URL>/api/brain/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare R2 para anexos/originais (opcional; vazio = armazenamento local).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ATTACHMENTS=
# Recuperação T3 do brain (índice reaproveita QDRANT_URL/VOYAGE_API_KEY da memória).
# WhatsApp (bridge GOWA em container; usar número secundário) e Slack (Socket Mode).
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3010
WHATSAPP_BRIDGE_AUTH=
# URL que o container do bridge usa para chamar o webhook do claudemar.
# Padrão: http://host.docker.internal:$DASHBOARD_PORT/api/brain/whatsapp/webhook
WHATSAPP_BRIDGE_WEBHOOK=
BRAIN_WHATSAPP_WEBHOOK_SECRET=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
BM25_NORMALIZE_DIACRITICS=true
# Valor inicial do limiar (0 = shadow mode, sem corte). Depois de salvo em Configurações,
# o valor efetivo passa a vir de brain-settings.json e esta variável deixa de ter efeito.
RERANK_MIN_SCORE=0
SELECTOR_MIN_POOL=12
BRAIN_INCLUDE_PII_DEFAULT=false
