TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# ── Provedores LLM ──
# Perfis em Settings → Provedores de LLM. Anthropic nativo usa a subscription do Claude;
# os modelos GPT usam a assinatura do ChatGPT (login do Codex em Settings → Conta OpenAI).
# OpenAI: usada APENAS pela transcrição de voz (Whisper), nunca pelos modelos GPT.
OPENAI_API_KEY=
# z.ai (GLM Coding Plan, endpoint Anthropic-compatible):
ZAI_API_KEY=
# Kimi Code (endpoint Anthropic-compatible):
KIMI_API_KEY=

AGENT_TIMEOUT_MS=0
# Limite opcional sem eventos do runner (ms). Pode interromper raciocínio ou
# ferramentas ainda em execução. 0 = desligado (padrão).
SESSION_INACTIVITY_TIMEOUT_MS=0
# Limite opcional sem eventos enquanto aguarda tarefas em background (ms).
# 0 = aguardar o término real (padrão). Um valor positivo interrompe a sessão.
PENDING_TASKS_GRACE_MS=0
DASHBOARD_TOKEN=
DASHBOARD_PORT=3000
# URL pública do dashboard. Exemplo de produção: https://claudemar.com.br
# Usada para embutir screenshots do E2E nos Pull Requests e para derivar o RP ID do WebAuthn.
# Vazio = recursos que dependem de URL pública ficam desativados.
PUBLIC_BASE_URL=

# MySQL (required for Tracker feature)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=claudemar
MYSQL_PASSWORD=
MYSQL_DATABASE=claudemar

# Files attached to prompts: days kept before removal (0 = keep forever) and per-user quota per target in MB (0 = unlimited).
PROMPT_ATTACHMENT_RETENTION_DAYS=30
PROMPT_ATTACHMENT_QUOTA_MB=2048

# Jev (TypeSafe) prompt complexity → recommended thinking effort. Leave JEV_API_KEY empty to disable.
# Official TypeSafe API endpoint (keys from the TypeSafe console).
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=8000

# Long-term memory (Qdrant + Voyage). Leave QDRANT_URL/VOYAGE_API_KEY empty to disable memory.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claudemar_sessions
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIM=1024
RERANK_MODEL=rerank-2.5
MEMORY_DOMAIN_INSTRUCTION=
RETRIEVE_CANDIDATES=40
RERANK_TOP_K=8
HYBRID_BM25=true

# Pipeline (esteira de desenvolvimento por agente)
MAX_PARALLEL_PIPELINE_RUNS=3
# Timeout padrão de cada etapa (ms). Override por etapa na UI: vazio = usa este padrão,
# 0 = sem limite (para tasks longas), N = N minutos. Padrão: 2h.
PIPELINE_STAGE_TIMEOUT_MS=7200000
# WebAuthn / Passkeys (login biométrico para admin).
# RP ID = domínio exato onde o dashboard roda, sem protocolo/porta. Exemplo: claudemar.com.br
# Em dev pode ficar como localhost. Deixe vazio para derivar de PUBLIC_BASE_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Claudemar

# ── Second Brain ──
# Redis (Streams/cursores/filas do brain). Serviço `redis` do docker-compose.
REDIS_URL=redis://127.0.0.1:6379
# Raiz do repositório do brain (raw/, wiki/, state/). Vazio = <basePath>/brain.
BRAIN_ROOT=
BRAIN_TZ=Europe/Madrid
# Chave da Anthropic dedicada ao pipeline do brain (triagem/compilação).
# NÃO usar ANTHROPIC_API_KEY: substituiria a auth por subscription do Agent SDK.
BRAIN_ANTHROPIC_API_KEY=
# OAuth client do Google Cloud (Gmail + Calendar, escopo readonly).
# Redirect URI: <PUBLIC_BASE_URL>/api/brain/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ── Google Drive nas Entradas dos agentes ──
# OAuth client PRÓPRIO (tipo Web application), separado do Second Brain: cada usuário com acesso
# a um agente conecta a própria conta Google e compartilha pastas com o agente.
# No Google Cloud: ative a Google Drive API (e Google Docs, Sheets e Slides APIs, usadas pelas ferramentas
# de leitura/edição desses arquivos), inclua o escopo drive.readonly na tela de consentimento
# (e o escopo drive, para compartilhar pastas com permissão de escrita) e cadastre o redirect URI
# <PUBLIC_BASE_URL>/api/google-drive/callback.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Intervalo da sincronização automática em minutos (0 = só sob demanda pelo botão Sync).
GOOGLE_DRIVE_SYNC_INTERVAL_MINUTES=10
# Limites por pasta conectada (0 = sem limite): número de arquivos, tamanho por arquivo e total.
GOOGLE_DRIVE_MAX_FILES=5000
GOOGLE_DRIVE_MAX_FILE_MB=100
GOOGLE_DRIVE_MAX_FOLDER_MB=2048
# Cloudflare R2 para anexos/originais (opcional; vazio = armazenamento local).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ATTACHMENTS=
# Recuperação T3 do brain (índice reaproveita QDRANT_URL/VOYAGE_API_KEY da memória).
# WhatsApp (bridge GOWA em container; usar número secundário) e Slack (Socket Mode).
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3010
WHATSAPP_BRIDGE_AUTH=
# URL que o container do bridge usa para chamar o webhook do claudemar.
# Padrão: http://host.docker.internal:$DASHBOARD_PORT/api/brain/whatsapp/webhook
WHATSAPP_BRIDGE_WEBHOOK=
BRAIN_WHATSAPP_WEBHOOK_SECRET=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
BM25_NORMALIZE_DIACRITICS=true
# Valor inicial do limiar (0 = shadow mode, sem corte). Depois de salvo em Configurações,
# o valor efetivo passa a vir de brain-settings.json e esta variável deixa de ter efeito.
RERANK_MIN_SCORE=0
SELECTOR_MIN_POOL=12
BRAIN_INCLUDE_PII_DEFAULT=false
