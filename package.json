{
  "name": "claudemar",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build": "tsup src/main.ts src/schedule-run.ts src/pipeline-intake-run.ts --format esm",
    "build:dashboard": "cd dashboard && npm run build",
    "build:all": "npm run build:dashboard && npm run build",
    "start": "node dist/main.js",
    "test": "tsx --test \"test/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check:unused": "knip",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.2",
    "@qdrant/js-client-rest": "^1.18",
    "@simplewebauthn/server": "^13.3.2",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "archiver": "^7.0.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^174.0.1",
    "grammy": "^1.40.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.2.3",
    "mysql2": "^3.19.1",
    "openai": "^6.19.0",
    "socket.io": "^4.8.3",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "@types/turndown": "^5.0.6",
    "knip": "^6.37.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
